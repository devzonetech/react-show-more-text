{
  "name": "react-show-more-text",
  "version": "1.8.0-rc.1",
  "type": "module",
  "description": "The text surrounded by the component will be truncated. Anything surrounded by the component could be evaluated as text. The component react-show-more-text/ShowMoreText is fork of react-show-more/ShowMore, applied improvements, works with React 16.x.x, added onClick event.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && node scripts/copy-types.js",
    "build:watch": "vite build --watch",
    "clean": "rm -rf dist",
    "coverage": "vitest --coverage --run",
    "lint": "eslint src/",
    "preversion": "npm run test && npm run build",
    "report-coverage": "npm run coverage && coveralls < coverage/lcov.info",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:types": "tsc --noEmit -p tsconfig.types.json",
    "test:watch": "vitest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/devzonetech/react-show-more-text.git"
  },
  "homepage": "https://github.com/devzonetech/react-show-more-text",
  "keywords": [
    "react",
    "show more",
    "ellipsis",
    "multiline",
    "show more text",
    "show partial text",
    "hide partial text",
    "show-more fix",
    "show text",
    "hide text"
  ],
  "author": "Zdravko Shishmanov",
  "license": "ISC",
  "peerDependencies": {
    "react": "18 - 19.x"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "8.6.19",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "8.6.19",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "overrides": {
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "14.0.6"
    }
  },
  "browserslist": "> 0.25%, not dead",
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
